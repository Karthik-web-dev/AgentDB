# AgentDB Backend Environment Configuration

# Server Settings
APP_NAME=AgentDB
DEBUG=True
API_V1_STR=/api/v1

# JWT Authentication
# SECRET_KEY must be set via environment variable in production.
# This file is gitignored; never commit a real secret.
SECRET_KEY=change-this-to-a-random-64-character-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agentdb
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# OpenRouter (or another OpenAI-compatible chat completions endpoint)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:8080
OPENROUTER_APP_NAME=AgentDB
AGENT_MEMORY_MESSAGES=20
AGENT_MEMORY_RECENT_MAX_CHARS=24000
AGENT_MEMORY_SUMMARY_MAX_CHARS=5000
AGENT_MEMORY_SUMMARIZE_CHUNK_CHARS=5000
LLM_MAX_OUTPUT_TOKENS=2048
