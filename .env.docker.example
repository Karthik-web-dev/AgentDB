# Copy to .env (git-ignored) and fill in real values before `docker compose up`.
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-character-random-hex-string
# OpenRouter configuration. Keep the key private; do not commit a real value.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:8080
OPENROUTER_APP_NAME=AgentDB
AGENT_MEMORY_MESSAGES=20
AGENT_MEMORY_RECENT_MAX_CHARS=24000
AGENT_MEMORY_SUMMARY_MAX_CHARS=5000
AGENT_MEMORY_SUMMARIZE_CHUNK_CHARS=5000
LLM_MAX_OUTPUT_TOKENS=2048
